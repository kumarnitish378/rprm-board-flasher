{
  "family": "avr",
  "_comment": [
    "Board profiles are data, not code. To add a board, copy an entry and edit it,",
    "then restart the tool. 'chip' is an avrdude part id (run: avrdude -p ? for the",
    "full list of 172). 'signature' is what the chip reports when detected.",
    "",
    "Modes:",
    "  isp_uno        - an UNO running ArduinoISP drives the target over SPI.",
    "                   The port is the UNO's, not the target's. Chip-erases,",
    "                   which destroys the target's bootloader.",
    "  usb_bootloader - the target's own bootloader receives the firmware over",
    "                   its USB port. Leaves the bootloader intact."
  ],

  "boards": [
    {
      "id": "mega2560",
      "name": "Arduino Mega 2560",
      "chip": "atmega2560",
      "signature": "0x1e9801",
      "flash_bytes": 262144,
      "notes": "8 KB of flash is reserved for the bootloader when one is present.",
      "modes": {
        "isp_uno": {
          "label": "UNO as ISP programmer",
          "description": "Flash through an Arduino UNO running the ArduinoISP sketch.",
          "erases_bootloader": true,
          "port_belongs_to": "programmer",
          "options": { "programmer": "stk500v1", "baud": 19200, "chip_erase": true }
        },
        "usb_bootloader": {
          "label": "Direct USB (bootloader)",
          "description": "Flash over the Mega's own USB cable. Needs a working bootloader.",
          "port_belongs_to": "target",
          "options": { "programmer": "wiring", "baud": 115200, "extra": ["-D"] }
        }
      },
      "wiring": {
        "isp_uno": [
          ["D10", "RESET"],
          ["D11 (MOSI)", "D51"],
          ["D12 (MISO)", "D50"],
          ["D13 (SCK)", "D52"],
          ["5V", "5V"],
          ["GND", "GND"]
        ]
      }
    },

    {
      "id": "mega1280",
      "name": "Arduino Mega 1280",
      "chip": "atmega1280",
      "signature": "0x1e9703",
      "flash_bytes": 131072,
      "modes": {
        "isp_uno": {
          "label": "UNO as ISP programmer",
          "erases_bootloader": true,
